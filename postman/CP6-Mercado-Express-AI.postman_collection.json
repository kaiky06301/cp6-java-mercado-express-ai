{
  "info": {
    "name": "CP6 - Mercado Express AI (Spring AI + Ollama)",
    "description": "POST /api/chat e GET /api/historico. Rode a aplicação (porta 8080) com o Ollama e o PostgreSQL ativos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Pergunta válida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chat"
          ]
        },
        "description": "Consulta real ao modelo local. O texto gerado pode variar entre execuções.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mensagem\": \"Quero fazer um almoço de domingo para 4 pessoas. Monte uma lista de compras e diga se o frete sai grátis.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Campos obrigatórios', () => ['id','resposta','provedor','modelo','dataHora'].forEach(c => pm.expect(r).to.have.property(c)));",
              "pm.test('Provedor Ollama', () => pm.expect(r.provedor).to.eql('Ollama'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Pergunta fora do domínio (recusa)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chat"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mensagem\": \"Quem ganhou a Copa do Mundo de 2002?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Recusa educada', () => pm.expect(pm.response.json().resposta).to.include('Mercado Express'));"
            ]
          }
        }
      ]
    },
    {
