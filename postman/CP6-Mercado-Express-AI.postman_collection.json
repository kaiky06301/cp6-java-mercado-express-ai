    {
      "name": "7. Falha do provedor - Ollama parado (503)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chat"
          ]
        },
        "description": "Para demonstrar: pare o Ollama (ou suba a aplicação com OLLAMA_BASE_URL=http://localhost:11999) e envie. Para modelo não instalado, use OLLAMA_MODEL=modelo-inexistente:1b.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mensagem\": \"Quais formas de pagamento vocês aceitam?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 503', () => pm.response.to.have.status(503));",
              "pm.test('Mensagem compreensível sem segredos', () => { const m = pm.response.json().mensagem; pm.expect(m).to.include('Ollama'); pm.expect(m).to.not.include('11434'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Histórico (mais recentes primeiro)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/historico",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "historico"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const h = pm.response.json();",
              "pm.test('Ordenado por data desc', () => { for (let i=1;i<h.length;i++) pm.expect(h[i-1].dataHora >= h[i].dataHora).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Histórico (mais antigos primeiro)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/historico?ordem=asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "historico"
          ],
          "query": [
            {
              "key": "ordem",
              "value": "asc"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
